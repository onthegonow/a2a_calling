{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "A2A Callbook",
  "version": "0.1.0",
  "identifier": "com.openclaw.a2a-callbook",
  "build": {
    "frontendDist": "../index.html"
  },
  "app": {
    "windows": [
      {
        "title": "A2A Callbook",
        "width": 1024,
        "height": 720,
        "minWidth": 480,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "dangerousRemoteUrlAccess": [
        { "url": "http://127.0.0.1:**" },
        { "url": "http://localhost:**" }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "frameworks": []
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["a2a"]
      }
    }
  }
}
