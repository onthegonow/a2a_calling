{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "A2A Callbook",
  "version": "0.6.74",
  "identifier": "com.openclaw.a2a-callbook",
  "build": {
    "frontendDist": "../index.html"
  },
  "app": {
    "windows": [
      {
        "title": "A2A Callbook",
        "width": 1024,
        "height": 720,
        "minWidth": 480,
        "minHeight": 600,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "externalBin": [
      "binaries/a2a-server"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/512x512@2x.png"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "frameworks": [],
      "entitlements": "entitlements.plist",
      "dmg": {
        "background": "dmg-background.png",
        "windowSize": { "width": 600, "height": 400 },
        "windowPosition": { "x": 200, "y": 200 },
        "appPosition": { "x": 160, "y": 240 },
        "applicationFolderPosition": { "x": 440, "y": 240 }
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "a2a"
        ]
      }
    }
  }
}
