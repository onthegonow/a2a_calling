{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "A2A Callbook",
  "version": "0.6.74",
  "identifier": "com.openclaw.a2a-callbook",
  "build": {
    "frontendDist": "../index.html"
  },
  "app": {
    "windows": [
      {
        "title": "A2A Callbook",
        "width": 1024,
        "height": 720,
        "minWidth": 480,
        "minHeight": 600,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "updater"
    ],
    "externalBin": [
      "binaries/a2a-server"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "frameworks": [],
      "entitlements": "entitlements.plist"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "a2a"
        ]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/onthegonow/a2a_calling/releases/latest/download/latest.json"
      ],
      "pubkey": "PLACEHOLDER_REPLACE_WITH_ACTUAL_PUBLIC_KEY",
      "dialog": false
    }
  }
}
