{
  "name": "a2acalling",
  "version": "0.6.76",
  "description": "Agent-to-agent calling for OpenClaw - A2A agent communication",
  "main": "src/index.js",
  "bin": {
    "a2a": "bin/cli.js",
    "a2acalling": "scripts/install-openclaw.js"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "serena:init": "node scripts/bootstrap-serena.js",
    "serena:check": "node scripts/bootstrap-serena.js --check",
    "start": "node src/server.js",
    "test": "node test/run.js",
    "test:coverage": "c8 node test/run.js",
    "lint": "biome lint src/",
    "lint:check": "biome check src/",
    "knip": "knip",
    "test:e2e:standalone": "node test/run.js --e2e --filter standalone",
    "build:standalone": "bash scripts/build-standalone.sh",
    "build:sync-version": "bash scripts/sync-version.sh"
  },
  "keywords": [
    "openclaw",
    "claudebot",
    "agent",
    "a2a",
    "calling",
    "ai"
  ],
  "author": "OpenClaw Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onthegonow/a2a_calling.git"
  },
  "bugs": {
    "url": "https://github.com/onthegonow/a2a_calling/issues"
  },
  "homepage": "https://github.com/onthegonow/a2a_calling#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.0.0",
    "@biomejs/biome": "^2.4.4",
    "c8": "^11.0.0",
    "eslint": "^10.0.2",
    "eslint-plugin-sonarjs": "^4.0.0",
    "knip": "^5.85.0"
  }
}
